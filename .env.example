# cyber_bench — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# NEVER commit real keys. Load it before running any benchmark with:
#
#     set -a; source .env; set +a
#
# Only the variables for the agent/benchmark you actually run are required.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. Agent / LLM provider credentials
# ---------------------------------------------------------------------------
# Set the key(s) for whichever provider your chosen model uses. The loop CLI
# natively supports soket, openrouter, and openai; the other eval_*.py drivers
# map provider -> key env var as noted.

# Soket / TensorStudio (loop default provider; model e.g. GLM-5.3)
SOKET_API_KEY=

# OpenRouter (loop --provider openrouter; model e.g. z-ai/glm-5.3)
# NOTE: loop must have the model registered once via an interactive
#       `loop` -> /login -> /model session before headless --print runs work.
OPENROUTER_API_KEY=

# OpenAI (eval_codex.py, eval_loop.py --provider openai)
OPENAI_API_KEY=

# Anthropic (eval_claude.py --provider anthropic)
ANTHROPIC_API_KEY=

# DeepSeek (eval_deepseek.py / dsh)
DEEPSEEK_API_KEY=

# Google Gemini (optional, some drivers)
GEMINI_API_KEY=


# ---------------------------------------------------------------------------
# 2. Model / provider selection
# ---------------------------------------------------------------------------
# Used by the CyberGym runner flags and as defaults in docs. For SEC-bench Pro,
# model/provider live in each harness/configs/<agent>/<proj>/*.toml instead.
LOOP_PROVIDER=openrouter
LOOP_MODEL=z-ai/glm-5.3

# Optional: pin a specific loop CLI version for in-container installs
# LOOP_VERSION=0.3.2


# ---------------------------------------------------------------------------
# 3. CyberGym
# ---------------------------------------------------------------------------
# Local dataset + grading server (see README section 4). The server must bind
# to the Docker network gateway, never 0.0.0.0 (see cybergym/FAQ.md Q4).
CYBERGYM_DATA_DIR=./cybergym_data/data
CYBERGYM_SERVER=http://127.0.0.1:8666
# Generate with: openssl rand -hex 32   (override the public placeholder)
CYBERGYM_API_KEY=
# Task difficulty: level0 (crash dump) .. level2 (minimal hint)
CYBERGYM_DIFFICULTY=level1


# ---------------------------------------------------------------------------
# 4. SEC-bench Pro
# ---------------------------------------------------------------------------
# Most settings live in the per-agent TOML configs; these are only the
# cross-cutting ones the harness reads from the environment.

# Codex host-auth passthrough (eval_codex.py), if using ~/.codex/auth.json
# CODEX_AUTH_JSON=~/.codex/auth.json

# AWS Bedrock (only if a config selects provider = "bedrock")
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1


# ---------------------------------------------------------------------------
# 5. Tracing (optional) — forwarded into containers by the drivers
# ---------------------------------------------------------------------------
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
